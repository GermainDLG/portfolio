# Gmail OAuth
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_ADDRESS=name@domain.com

# Anthropic
ANTHROPIC_API_KEY=sk-...

# Recipients (comma-separated)
RECIPIENTS=name@domain.com
ALLOWED_DOMAINS=sampledomain.com

# Source URLs (comma-separated pages to scrape)
SOURCE_URLS=https://techcrunch.com/feed/,https://theaiinsider.tech/feed/

# Filtering
KEYWORDS=AI startup,funding,seed round,Series A,Series B,AI tool,LLM,AI agent,acquisition,VC,venture capital,early-stage,AI
BLOCKED_DOMAINS=wsj.com,ft.com

# Pipeline
DB_PATH=digest.db
LOG_PATH=digest.log

COGNITO_SECRET=...

DISABLE_AUTH=0